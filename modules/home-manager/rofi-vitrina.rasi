/* vitrina — rofi theme matching the quickshell island.
   palette is generated by pywal (see modules/home-manager/pywal.nix). */
@import "/home/theo/.cache/wal/rofi-colors.rasi"

* {
    font: "Cantarell 11";
    background-color: transparent;
    text-color: @vt-fg;
    margin: 0;
    padding: 0;
    border: 0;
}

window {
    width: 640px;
    background-color: @vt-bg;
    border: 1px;
    border-color: @vt-accent-45;
    border-radius: 14px;
    padding: 14px;
    location: center;
    yoffset: -70;
}

mainbox {
    spacing: 10px;
    padding: 0;
}

inputbar {
    background-color: @vt-fg-0a;
    border: 1px;
    border-color: @vt-fg-14;
    border-radius: 10px;
    padding: 10px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @vt-accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @vt-muted;
    text-color: @vt-fg;
    cursor: text;
}

listview {
    lines: 9;
    columns: 1;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
    background-color: transparent;
    padding: 2px 0 2px 0;
}

element {
    padding: 9px 11px;
    spacing: 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @vt-fg;
}

element selected {
    background-color: @vt-accent-26;
    text-color: @vt-fg;
}

element-icon {
    size: 18px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element normal urgent {
    text-color: @vt-accent;
}

mode-switcher {
    background-color: transparent;
    spacing: 6px;
    padding: 4px 0 0 0;
}

button {
    background-color: @vt-fg-0a;
    text-color: @vt-muted;
    border-radius: 8px;
    padding: 6px 10px;
}

button selected {
    background-color: @vt-accent-26;
    text-color: @vt-fg;
}

message {
    background-color: @vt-fg-0a;
    border-radius: 8px;
    padding: 8px;
}

textbox {
    text-color: @vt-fg;
}

error-message {
    background-color: @vt-accent-26;
    text-color: @vt-fg;
    border-radius: 8px;
    padding: 8px;
}