{ pkgs, ... }:
{
  gtk = {
    enable = true;

    # proportional UI face everywhere (nerd glyphs fall back per-glyph)
    font = {
      name = "Cantarell";
      size = 10;
    };

    theme = {
      name = "adw-gtk3-dark";
      package = pkgs.adw-gtk3;
    };

    iconTheme = {
      name = "Papirus-Dark";
      package = pkgs.papirus-icon-theme;
    };

    gtk2.extraConfig = "gtk-application-prefer-dark-theme = true\n";

    gtk3.extraConfig = {
      gtk-application-prefer-dark-theme = 1;
      gtk-cursor-theme-size = 8;
    };

    gtk4.extraConfig = {
      gtk-application-prefer-dark-theme = 1;
      gtk-theme-name = "adw-gtk3-dark";
      gtk-icon-theme-name = "Papirus-Dark";
      gtk-cursor-theme-size = 8;
    };
  };

  # NOTE: gtk-4.0/settings.ini is generated by home-manager from the
  # gtk.* options above — do NOT add a manual xdg.configFile for it here.
  # A manual block concatenates with the generated one (double [Settings]
  # header, see issue) and fights over gtk-theme-name. Keep theme pins in
  # gtk4.extraConfig instead.

  # NOTE: gtk-theme / icon-theme / color-scheme are deliberately NOT declared in
  # dconf.settings. They are mode-dependent now (light vs dark, see pywal.nix),
  # and a declarative dconf key is rewritten on every activation — a rebuild
  # would silently drag a light rice back to prefer-dark until the next set-wal.
  # set-wal is the single writer for those three keys.
  home.pointerCursor = {
    enable = true;
    name = "Bibata-Modern-Ice";
    gtk.enable = true;
    x11.enable = true;
    size = 8;
    package = pkgs.bibata-cursors;
  };
  qt = {
    enable = true;
    platformTheme.name = "qtct";
    style.name = "fusion";
  };

  # qt5ct / qt6ct so qt5 + qt6 both read the pywal palette.
  # hm sets QT_QPA_PLATFORMTHEME from platformTheme.name.
  home.packages = with pkgs; [
    libsForQt5.qt5ct
    qt6Packages.qt6ct
  ];
}
